# Copy to .env and adjust.

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/samsung_phones
# For a zero-setup local run you can use SQLite instead:
# DATABASE_URL=sqlite:///./data/samsung_phones.db

# --- LLM (open-source models) ------------------------------------------------
# auto | ollama | huggingface | openai | none
LLM_PROVIDER=auto

# Ollama (local, free): `ollama pull llama3.1:8b`  (use llama3.2:3b on 8 GB RAM machines)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Hugging Face Inference router (hosted open-source models): https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- RAG ---------------------------------------------------------------------
EMBEDDING_BACKEND=tfidf          # or sentence-transformers
RETRIEVAL_TOP_K=6

# --- Scraper -----------------------------------------------------------------
SCRAPE_DELAY_SECONDS=3
